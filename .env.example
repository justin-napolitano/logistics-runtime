# Local synthetic PostgreSQL only; configure real connections through Infisical.
DATABASE_URL=postgres://logistics_test@127.0.0.1:55439/logistics_test?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
# Supply a randomly generated value of at least 32 characters outside Git.
API_TOKEN=
# Inject real values through Infisical; never commit operational env files.
INFISICAL_URL=https://app.infisical.com
INFISICAL_GCP_IDENTITY_ID=
INFISICAL_CONFIG_PATH=
# Explicit names only; hosted jobs read these from the scoped Infisical folder.
INFISICAL_BOOTSTRAP_SECRETS=
MAIL_GOOGLE_CLIENT_ID=
MAIL_GOOGLE_CLIENT_SECRET=
MAIL_MICROSOFT_CLIENT_ID=
MAIL_MICROSOFT_CLIENT_SECRET=
MAIL_MICROSOFT_TENANT=common
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=/
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# Alternative for short-lived jobs; expires according to its configured TTL.
INFISICAL_TOKEN=
